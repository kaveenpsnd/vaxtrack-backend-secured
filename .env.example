# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Sign in with Google (OpenID Connect) — from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, type "Web application").
# GOOGLE_REDIRECT_URI is the FRONTEND callback page and must exactly match an
# "Authorized redirect URI" on the client. Keep the secret server-side only.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# CORS — comma-separated list of browser origins allowed to call this API.
# Leave unset to use the defaults (deployed frontend + local Vite dev server).
CORS_ORIGINS=https://vaxtrackweb.netlify.app,http://localhost:5173

# Cloudinary Configuration
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Geocoding Service (LocationIQ)
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_key
EMAIL_FROM=noreply@vaxtrack.lk

# Performance Testing (Artillery)
# Override the target URL for test:perf:cloud (defaults to the Render deployment)
PERF_TARGET=https://vaxtrack-api.onrender.com
