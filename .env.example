# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# CORS — comma-separated list of browser origins allowed to call this API.
# Leave unset to use the defaults (deployed frontend + local Vite dev server).
CORS_ORIGINS=https://vaxtrackweb.netlify.app,http://localhost:5173

# Cloudinary Configuration
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Geocoding Service (LocationIQ)
LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_app_key
EMAIL_FROM=noreply@vaxtrack.lk

# Performance Testing (Artillery)
# Override the target URL for test:perf:cloud (defaults to the Render deployment)
PERF_TARGET=https://vaxtrack-api.onrender.com

# WSO2 Identity Server — OpenID Connect single sign-on
# WSO2_BASE is the server root, e.g. https://auth.example.org (no trailing path)
WSO2_BASE=
WSO2_CLIENT_ID=
WSO2_CLIENT_SECRET=
# Must exactly match the callback URL registered for the app in WSO2
# (local: http://localhost:5000/api/auth/wso2/callback — the port must equal PORT)
WSO2_REDIRECT_URI=
# Browser origin of the React frontend (SSO success/failure redirects go here)
# (local: http://localhost:5173 — also register ${FRONTEND_URL}/login as a
# post-logout redirect URL and ${FRONTEND_URL} as an allowed origin in WSO2)
FRONTEND_URL=
# Long random string used to sign the SSO transaction cookie (e.g. `openssl rand -hex 32`)
COOKIE_SECRET=
